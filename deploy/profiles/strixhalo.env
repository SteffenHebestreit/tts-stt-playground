# =============================================================================
# Device preset — AMD Strix Halo (Ryzen AI Max+ 395), 128 GB unified memory
# =============================================================================
#   docker compose --env-file deploy/profiles/strixhalo.env \
#     -f docker-compose.yml -f docker-compose.vulkan.yml \
#     --profile frontend --profile piper-tts --profile whisper-cpp up -d
#
# gfx1151 / RDNA 3.5 / Radeon 8060S. Capacity is huge but memory BANDWIDTH is
# shared with the CPU and is the real limit — a bigger model is affordable in
# bytes but not necessarily in time.
# =============================================================================

IMAGE_TAG=latest

# --- STT: whisper.cpp via Vulkan ---------------------------------------------
# Deliberately NOT stt-service: CTranslate2's PyPI wheels are CUDA-only, so
# FORCE_ACCELERATION=rocm silently resolves to CPU int8 on this box.
# Vulkan needs only /dev/dri and no per-target kernel compilation, which makes
# it the portable AMD path. large-v3-turbo-q5_0 is published (unlike small-q5_0).
ENABLE_WHISPER_CPP=true
# stt-service is not started here, so the UI's default engine ("whisper") would
# point at nothing. The Vulkan whisper.cpp is the STT engine of this device.
DEFAULT_STT_PROVIDER=whisper-cpp
WHISPER_MODEL=large-v3-turbo-q5_0
WHISPER_CPP_EXTRA_ARGS=--language de
GGML_VULKAN_DEVICE=0

# --- TTS ---------------------------------------------------------------------
# Piper on the CPU is the right answer here: this CPU is far faster than the
# ARM SBC where Piper already runs comfortably in realtime, and it costs no GPU.
PIPER_DEFAULT_VOICE=de_DE-thorsten-medium

# --- Voice training ------------------------------------------------------------
# The command above does not start piper-training-service (`--profile training`).
# Without this line the UI shows a Voice Training tab and a status dot that can
# only be red. Set it to true when you add --profile training.
ENABLE_TRAINING=false

# --- If you use the ROCm overlay for the PyTorch services --------------------
# Add docker-compose.rocm.yml to the command above. Its defaults already carry
# what this device needs (HSA_OVERRIDE_GFX_VERSION=11.0.0 while the Dockerfile.rocm
# images pin the rocm6.2 wheel index, PYTORCH_ALLOC_CONF=expandable_segments:True),
# so nothing is set here. Clear the override when those images move to rocm7.0+,
# which has native gfx1151 kernels.
#
# Reported "VRAM" is misleading on a unified-memory APU: mem_get_info() returns
# the GTT pool, i.e. system RAM. Size the models by hand (MODEL_TTL keeps the
# resident set small) instead of trusting it. There is no GPU_MEMORY_BUDGET_GB
# knob; an earlier revision of this file set one that nothing ever read.
