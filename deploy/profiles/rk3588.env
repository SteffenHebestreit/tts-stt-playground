# =============================================================================
# Device preset — Rockchip RK3588S SBC (8 GB and 16 GB), ARM64
# =============================================================================
# No CUDA, no ROCm. Everything here runs on the CPU.
#
#   docker compose --env-file deploy/profiles/rk3588.env \
#     -f docker-compose.yml -f docker-compose.arm64.yml \
#     --profile frontend --profile piper-tts --profile whisper-cpp up -d
#
# NOTE the explicit profiles: the `all` aggregate does NOT include whisper-cpp,
# and it DOES include GPU services that cannot run here. Never use `--profile
# all` on this device.
#
# Services that CANNOT run on ARM64 (all are nvidia/cuda based, and NeMo/Qwen
# have no ARM story): stt-service, qwen3-asr, qwen3-tts, parakeet-asr,
# canary-asr, chatterbox-tts, piper-training.
# =============================================================================

IMAGE_TAG=latest

# --- STT: whisper.cpp on the CPU ---------------------------------------------
ENABLE_WHISPER_CPP=true
#
# THE most important line in this file, and the one to revisit first.
#
# The repo default (large-v3-turbo-q5_0) is far slower than real time here.
# Measured on RK3588: `small` RTF 0.47, `medium` RTF 1.51.
#
# Note what that means for a SEQUENTIAL pipeline (STT -> LLM -> TTS), which is
# how this board is used: the binding constraint is COMPUTE, not memory. Running
# the stages one after another frees RAM but does not make any single stage
# faster. So a bigger model does not become "affordable" just because nothing
# else is resident — it becomes affordable only if you can wait for it.
#
#   small-q5_1   RTF 0.47  -> a 30 s clip transcribes in ~14 s   (default)
#   medium-q5_1  RTF 1.51  -> the same clip takes ~45 s
#
# Pick by turn latency, not by free memory. `small` is multilingual and includes
# German; switch up only if accuracy matters more than responsiveness.
# NOTE: `small` has no q5_0 build published; q5_1 is the quantised one.
WHISPER_MODEL=small-q5_1
# 4 threads pinned to the A76 cluster is more reproducible than -t 8: per core,
# an A76 is ~4.4x an A55 on this die, so mixing clusters makes timings noisy.
WHISPER_CPP_EXTRA_ARGS=--language de --threads 4

# --- TTS: Piper on the CPU ---------------------------------------------------
# Measured RTF 0.10-0.12 for medium voices on RK3588 — comfortably realtime.
# de_DE-thorsten-medium is a German voice by construction.
PIPER_DEFAULT_VOICE=de_DE-thorsten-medium

# --- Sequential pipeline -----------------------------------------------------
# This board runs STT -> (LLM) -> TTS one stage at a time, so peak memory is
# max(stage), not sum(stages). Nothing here needs to be co-resident.
#
# Consequence: idle stages should give their memory back. Keep the TTL short
# enough that a finished stage releases before the next one loads, but long
# enough that a multi-turn conversation does not reload on every turn.
STT_MODEL_TTL=120
TTS_MODEL_TTL=120

# --- Keep the footprint small ------------------------------------------------
# Generated audio is throwaway on an SBC with eMMC.
OUTPUT_RETENTION_HOURS=2
# Single gateway worker: ~160 MB of RAM back, and an SBC serves few clients.
FRONTEND_WORKERS=1
