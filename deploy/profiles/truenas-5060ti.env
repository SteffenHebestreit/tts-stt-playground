# =============================================================================
# Device preset — TrueNAS server, NVIDIA RTX 5060 Ti (Blackwell, sm_120)
# =============================================================================
#   docker compose --env-file deploy/profiles/truenas-5060ti.env \
#     -f docker-compose.yml -f docker-compose.truenas.yml --profile all up -d
#
# sm_120 requires CUDA 12.8 + cu128 wheels. Every service in this repo is on
# that now; cu118/cu121 images fail here with cudaErrorNoKernelImageForDevice.
#
# VRAM: the budgets below are planned against 12 GB, the conservative figure.
# The repo's docs disagree between 12 and 16 GB for this card; confirm yours with
# `nvidia-smi --query-gpu=memory.total --format=csv` and relax the TTLs if it has
# more. Nothing in this file needs changing if it does.
# =============================================================================

# IMAGE_TAG is deliberately not set: docker-compose.truenas.yml pins the release
# this checkout belongs to. Setting IMAGE_TAG=latest here overrode that pin.

# --- STT ---------------------------------------------------------------------
WHISPER_MODEL_SIZE=large-v3-turbo
# INT8 is DISABLED for sm_120 in CTranslate2 ("Disable INT8 for sm120 - Blackwell
# GPUs", CTranslate2 releases), so the int8_float16 default cannot apply here.
# Pin float16 explicitly rather than relying on the probe silently falling back.
WHISPER_COMPUTE_TYPE=float16
WHISPER_NUM_WORKERS=2
WS_MAX_SESSIONS=4

# --- TTS ---------------------------------------------------------------------
# Tight budget: keep the small Qwen3-TTS and use Piper as the always-on cheap
# tier (CPU, zero VRAM) so the GPU stays free for ASR.
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# On a 12 GB budget the base stack is ~9.7 GB, so a further TTS model (chatterbox or
# magpie, ~4 GB each, opt-in) only fits if idle models give their VRAM back. This is what makes
# it usable here at all.
TTS_MODEL_TTL=120
# Same reasoning for the ~4 GB ASR model: idle services must give VRAM back for
# anything else to fit.
ASR_MODEL_TTL=120

# --- Voice training ------------------------------------------------------------
# `--profile all` does not include piper-training-service (`--profile training`).
# Without this line the UI shows a Voice Training tab and a status dot that can
# only be red. Set it to true when you add --profile training.
ENABLE_TRAINING=false

# --- GPU sharing -------------------------------------------------------------
ASR_MAX_CONCURRENCY=1
TTS_MAX_CONCURRENCY=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
