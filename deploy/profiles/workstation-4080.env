# =============================================================================
# Device preset — Workstation, NVIDIA RTX 4080 16 GB (Ada, sm_89)
# =============================================================================
#   docker compose --env-file deploy/profiles/workstation-4080.env \
#     -f docker-compose.yml --profile all --profile chatterbox-tts up -d
#
# The most conventional target: Ada predates the Blackwell wheel split, so
# cu118/cu121/cu128 all work, and INT8 is available (unlike sm_120).
# =============================================================================

IMAGE_TAG=latest

# --- STT ---------------------------------------------------------------------
WHISPER_MODEL_SIZE=large-v3-turbo
# int8_float16 is supported on Ada and saves ~35% weight memory vs float16.
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_NUM_WORKERS=2

# --- TTS ---------------------------------------------------------------------
# 16 GB affords the expressive German TTS alongside ASR.
ENABLE_CHATTERBOX_TTS=true
CHATTERBOX_DEFAULT_LANGUAGE=de
# NVIDIA Magpie (5 built-in voices, reads numbers and dates correctly, ~4.2 GB measured on this
# card) is the other German-capable engine. Resident next to Chatterbox it overshoots 16 GB, so
# either swap the two above, or lower TTS_MODEL_TTL below so an idle one gives its VRAM back:
#   docker compose --env-file deploy/profiles/workstation-4080.env -f docker-compose.yml \
#     --profile frontend --profile piper-tts --profile magpie-tts up -d --build
# ENABLE_MAGPIE_TTS=true
# MAGPIE_DEFAULT_LANGUAGE=de
# Two more German-capable speech-to-text engines, opt-in: Cohere Transcribe (~4.2 GB
# measured on this card) and IBM Granite Speech (~4.7 GB with the 2b, ~1.2 GB with the
# 470m TurboCTC). With the resident models above, start one at a time, or lower
# ASR_MODEL_TTL below so an idle one gives its VRAM back:
#   docker compose --env-file deploy/profiles/workstation-4080.env -f docker-compose.yml \
#     --profile frontend --profile cohere-asr --profile granite-asr up -d --build
# ENABLE_COHERE_ASR=true
# ENABLE_GRANITE_ASR=true
# The same candidates under vLLM's continuous batching (vllm-asr-service/README.md has the
# measurements from this card); it takes 0.45 of the card (~7.2 GB) while awake:
#   docker compose --env-file deploy/profiles/workstation-4080.env -f docker-compose.yml \
#     --profile frontend --profile vllm-asr up -d --build
# ENABLE_VLLM_ASR=true
# VLLM_ASR_MODEL=evewashere/cohere-transcribe-03-2026-ungated
# 16 GB has room to keep it resident, so skip the reload latency entirely.
TTS_MODEL_TTL=-1
ASR_MODEL_TTL=-1
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base

# --- Voice training ------------------------------------------------------------
# Neither command above starts piper-training-service (`--profile training`, which `all`
# does not include). Without this line the UI shows a Voice Training tab and a status
# dot that can only be red. Set it to true when you add --profile training.
ENABLE_TRAINING=false

# --- Headroom ----------------------------------------------------------------
ASR_MAX_CONCURRENCY=1
TTS_MAX_CONCURRENCY=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
