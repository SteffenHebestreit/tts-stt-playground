FROM rocm/dev-ubuntu-22.04:6.2-complete

WORKDIR /app

# See Dockerfile: PyAV bundles its own libav*, every requirement is a binary
# wheel, so the -dev packages, git and wget are not needed.
RUN apt-get update && apt-get install -y \
    python3 \
    python3-dev \
    python3-pip \
    curl \
    ffmpeg \
    libffi-dev \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

RUN mkdir -p /root/.cache/pip && chmod 777 /root/.cache/pip
RUN pip3 install --no-cache-dir --upgrade pip wheel setuptools

# Install ROCm-enabled PyTorch FIRST so ctranslate2 can detect HIP at install time
RUN pip3 install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/rocm6.2

# Install non-torch deps from requirements (torch line is commented out there).
# ctranslate2 comes from here, with the <5 cap requirements.txt puts on it.
#
# The ctranslate2 wheels on PyPI are CUDA-only — there is no ROCm variant
# published there. ROCm builds ship as GitHub release assets from CTranslate2
# v4.7.0 onward (https://github.com/OpenNMT/CTranslate2/releases) and require a
# matching system ROCm, which this rocm6.2 base does not provide. Until that is
# wired up, FORCE_ACCELERATION=rocm on this image resolves to CPU int8 — which
# works, and is why the fallback ladder in app.py matters. (An extra
# `pip install --upgrade ctranslate2 || echo` used to follow: it ignored the cap
# and reported a failed install as success.)
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh && sed -i 's/\r$//' /app/start.sh
COPY app.py .
# app.py does `from json_utils import ...` at import time. Omitting this made
# the ROCm image crash before uvicorn ever bound its port — masked in dev only
# because docker-compose.dev.yml mounts the source over the image.
COPY json_utils.py .
COPY residency.py .
# Imported by app.py at startup, like json_utils.py above.
COPY local_agreement.py .

RUN mkdir -p /app/models && chmod 755 /app/models

EXPOSE 8000

# See Dockerfile.
ENV HF_HUB_OFFLINE=0

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["/app/start.sh"]
