FROM rocm/dev-ubuntu-22.04:6.2-complete

WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3 \
    python3-dev \
    python3-pip \
    curl \
    git \
    ffmpeg \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    libffi-dev \
    libssl-dev \
    pkg-config \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

RUN mkdir -p /root/.cache/pip && chmod 777 /root/.cache/pip
RUN pip3 install --upgrade pip wheel setuptools

# Install ROCm-enabled PyTorch FIRST so ctranslate2 can detect HIP at install time
RUN pip3 install torch torchaudio --index-url https://download.pytorch.org/whl/rocm6.2

# Install non-torch deps from requirements (torch line is commented out there)
COPY requirements.txt .
RUN pip3 install -r requirements.txt

# NOTE: the ctranslate2 wheels on PyPI are CUDA-only — there is no ROCm variant
# published there, so this upgrade does NOT give you GPU decoding on AMD. ROCm
# builds ship as GitHub release assets from CTranslate2 v4.7.0 onward
# (https://github.com/OpenNMT/CTranslate2/releases) and require a matching
# system ROCm, which this rocm6.2 base does not provide.
# Until that is wired up, FORCE_ACCELERATION=rocm on this image resolves to
# CPU int8 — which works, and is why the fallback ladder in app.py matters.
RUN pip3 install --upgrade "ctranslate2>=4.0.0" || echo "ctranslate2 4.x unavailable, keeping existing version"

COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh && sed -i 's/\r$//' /app/start.sh
COPY app.py .
# app.py does `from json_utils import ...` at import time. Omitting this made
# the ROCm image crash before uvicorn ever bound its port — masked in dev only
# because docker-compose.dev.yml mounts the source over the image.
COPY json_utils.py .

RUN mkdir -p /app/models && chmod 755 /app/models

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["/app/start.sh"]
