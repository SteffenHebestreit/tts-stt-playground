FROM rocm/dev-ubuntu-22.04:6.2-complete

WORKDIR /app

# Install system dependencies
# (sox: qwen-tts imports the `sox` Python package, which only warns if the
# binary is missing; the 12Hz models used here never call it. Kept in line with
# the CUDA image to silence that warning.)
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    curl \
    git \
    ffmpeg \
    libsndfile1 \
    sox \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python

RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

RUN pip3 install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/rocm6.2

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# A requirement that re-resolved torch to the default (CUDA or CPU) wheel would
# leave this image running on the CPU with nothing to say so.
RUN python3 -c "import torch; assert torch.version.hip, 'torch %s is not a ROCm build' % torch.__version__"

COPY app.py .
# Request-body limit and cross-origin guard, imported by app.py at startup.
COPY body_limit.py .
COPY origin_guard.py .

EXPOSE 5004

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:5004/health || exit 1

# 120 s keep-alive: the gateway pools connections, and uvicorn's 5 s default
# closes them first, so pooled sockets came back dead.
CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "5004", "--timeout-keep-alive", "120"]
