########################################
# TTS-STT Services Configuration        #
########################################

# ===========================================
# HOST PORT CONFIGURATION
# ===========================================
# Only the web UI / API gateway (FRONTEND_PORT) has to be reachable from other
# machines: it proxies every backend call, the live microphone WebSocket
# included. The backend ports below exist for curl, benchmarks and scripts on the
# host itself, so they are published on BACKEND_BIND_ADDR, which defaults to the
# loopback interface. The backends have no authentication of their own.
#   BACKEND_BIND_ADDR=0.0.0.0   reach the backends from other hosts (LAN only!)
#   FRONTEND_BIND_ADDR=127.0.0.1  keep the UI local, e.g. behind a reverse proxy
#                                 running on the same host
BACKEND_BIND_ADDR=127.0.0.1
FRONTEND_BIND_ADDR=0.0.0.0
# Change the ports if they conflict with other services on your machine
FRONTEND_PORT=3000
PIPER_TTS_PORT=5000
STT_PORT=5001
QWEN3_ASR_PORT=5002
WHISPER_CPP_PORT=5003
QWEN3_TTS_PORT=5004
PARAKEET_ASR_PORT=5005
CANARY_ASR_PORT=5006
CHATTERBOX_TTS_PORT=5007
MAGPIE_TTS_PORT=5008
TRAINING_PORT=8080

# ===========================================
# CONTAINER IMAGES
# ===========================================
# Where prebuilt images are pulled from (and tagged when building locally).
# Published by CI to GHCR. Override to use your own registry/fork.
IMAGE_REGISTRY=ghcr.io/steffenhebestreit
# `latest` follows the newest release tag (vX.Y.Z) or the master branch, whichever was
# published last; both passed the CI checks first. It is convenient and an update can
# change behaviour, so pin IMAGE_TAG=X.Y.Z wherever a deployment has to be
# reproducible. Manual and branch builds are published as :sha-<commit> and
# :<branch> and never move `latest` or a version tag (publish-images.yml has the
# exact rule).
IMAGE_TAG=latest
# When `up` fetches images: missing (default: only if absent on the host) |
# always (pull on every `up`, what an update to a moved tag needs) | never | build.
# The -rocm and -vulkan overlays always build locally and ignore this.
PULL_POLICY=missing
# Appended to the Parakeet and Canary image tags. -nemo2 selects the rollback images
# built against NeMo 2.x (see the NeMo notes below); empty = the NeMo 3.x images.
NEMO_IMAGE_SUFFIX=

# ===========================================
# STORAGE / DATA LOCATION
# ===========================================
# Where persistent data lives on the host. Leave APP_DATA_DIR empty for local
# dev (data stays under the repo). On TrueNAS/servers, point it at a dataset and
# every data dir below moves there automatically, e.g.:
#   APP_DATA_DIR=/mnt/pool/apps/tts-stt
APP_DATA_DIR=
# Fine-grained overrides (default to ${APP_DATA_DIR}/<name>). Usually leave blank.
# MODELS_DIR=
# OUTPUT_DIR=
# CACHE_DIR=
# TRAINING_DATA_DIR=
# TRAINING_CHECKPOINTS_DIR=
# TRAINING_MODELS_DIR=
# TRAINING_CONFIGS_DIR=
# Model-download caches default to named Docker volumes; set to a dataset path to
# keep multi-GB Hugging Face downloads on your pool instead of the docker root.
# QWEN3_TTS_CACHE_DIR=
# QWEN3_ASR_CACHE_DIR=
# PARAKEET_ASR_CACHE_DIR=
# CANARY_ASR_CACHE_DIR=
# CHATTERBOX_TTS_CACHE_DIR=
# MAGPIE_TTS_CACHE_DIR=
# QWEN3_TTS_VOICES_DIR=
# WHISPER_CPP_MODELS_DIR=

# ===========================================
# HARDWARE ACCELERATION
# ===========================================
# GPU device selection (0 for first GPU, 1 for second, etc.)
CUDA_VISIBLE_DEVICES=0
# Docker-visible GPU set. For single-GPU TrueNAS custom-app deployments, keep this aligned with CUDA_VISIBLE_DEVICES.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Optional override. Only `rocm` is actually recognised by the code — it
# selects the ctranslate2 HIP probe. `cuda` and `cpu` are INERT: they fall
# through to auto-detection like an empty value. To force CPU, set
# USE_CUDA=false instead.
FORCE_ACCELERATION=

# --- ROCm / AMD GPU (used with docker-compose.rocm.yml) ---
# AMD GPU device index
HIP_VISIBLE_DEVICES=0
# Do NOT also set ROCR_VISIBLE_DEVICES. The two filters NEST rather than
# duplicate: the ROCr runtime applies its own list first, and HIP then indexes
# into the result. Setting both to 1 leaves ROCr exposing a single device at
# index 0, which HIP's index 1 then fails to find — so the pair works only for
# 0 and silently selects nothing above it. HIP_VISIBLE_DEVICES above is the one
# knob; the compose overlay deliberately forwards only that.
#
# GFX kernel-target override.
# Strix Halo (Ryzen AI Max+ 395) is Radeon 8060S, RDNA 3.5, target gfx1151.
# (Earlier versions of this file said "gfx1201" — that is RDNA 4 discrete
# hardware, a different chip entirely.) gfx1151 IS supported by current ROCm.
#
# This override is about the PyTorch WHEEL INDEX, not about ROCm itself:
#   * The Dockerfile.rocm images pin the rocm6.2 index (torch <= 2.5.1), whose
#     wheels carry no gfx1151 kernels — so Strix Halo needs 11.0.0 here to run
#     gfx1100 kernels instead. Leaving it empty gives "no kernel image".
#   * rocm7.0+ wheels (torch >= 2.10) carry gfx1151 natively. When the base
#     images are bumped, CLEAR THIS — forcing 11.0.0 on native kernels breaks
#     torchaudio resampling, which every ASR/TTS path in this stack uses.
#
# Empty is also correct for natively-supported cards such as RX 7900 (gfx1100).
HSA_OVERRIDE_GFX_VERSION=11.0.0

# ===========================================
# STT SERVICE (Whisper Speech-to-Text)
# ===========================================
# Whisper model size: tiny | base | small | medium | large-v3 | large-v3-turbo
# tiny: ~39MB, fast but lower accuracy
# base: ~74MB, balanced speed/accuracy
# small: ~244MB, good accuracy
# medium: ~769MB, high accuracy
# large-v3: ~1550MB, best accuracy — the only option that can task="translate"
# large-v3-turbo: ~1600MB, near-large-v3 accuracy with 4 decoder layers instead
#   of 32. Decoder depth dominates greedy realtime decoding, so this is the best
#   latency/accuracy trade for live transcription. Cannot translate.
# An unresolvable name falls back to large-v3 rather than failing startup.
# A Hugging Face repo id or the path of a CTranslate2 export (for example a
# German fine-tune converted with ct2-transformers-converter) is accepted as
# well and never escalates to large-v3; see stt-service/README.md.
WHISPER_MODEL_SIZE=large-v3-turbo

# CTranslate2 compute type. Empty = probe what the device actually supports and
# pick the best available, which is what you want on almost every host.
# On GPU the probe prefers int8_float16 (roughly half the VRAM of float16);
# int8_bfloat16 is only offered on compute capability 8.0+.
# NOTE: the accuracy cost of int8 has not been measured on GERMAN audio in this
# project. If German WER matters more than VRAM, set float16 explicitly.
#   cuda: float16 | int8_float16 | int8_bfloat16 | float32
#   cpu:  int8 | int8_float32 | float32
WHISPER_COMPUTE_TYPE=
# Force the device instead of auto-detecting: true | false | empty to auto.
USE_CUDA=
# Language used when a request names none. Empty = auto-detect. A client that
# sends `auto` explicitly still gets detection. The web UI sends `auto`, so this
# affects API callers that omit the field, not the browser.
STT_DEFAULT_LANGUAGE=
# Where model downloads go. Empty = the Hugging Face cache under /root/.cache
# (existing installs keep their weights there). Setting it starts a fresh download.
WHISPER_MODEL_DIR=
# 1 = never contact the Hugging Face Hub once the model is cached (air-gapped or
# flaky-network hosts). The first start still needs the model to be present.
HF_HUB_OFFLINE=0
# If the chosen model cannot fit in VRAM, load this one instead of failing.
# Keep it small enough to fit anywhere — it is the last resort before a 503.
WHISPER_OOM_FALLBACK=small

# --- File transcription limits (all ASR backends share the first two) ---
# Largest upload in MB and longest recording in seconds; both answer HTTP 413.
# 0 disables the length cap. The gateway has its own, larger MAX_UPLOAD_MB below
# (it also carries multi-file training uploads).
ASR_MAX_UPLOAD_MB=200
ASR_MAX_AUDIO_SECONDS=7200
# Threads for file transcription (also the ceiling on files decoded at once).
# Empty = min(4, CPU cores).
STT_BATCH_WORKERS=
# Opt in to faster-whisper's batched pipeline for /transcribe files (never for the
# live path). Needs the VAD filter, changes decoding (single temperature, no
# previous-text conditioning), costs ~+1.5 GB VRAM at batch 8. Compare German WER
# with benchmarks/run_german_eval.py before enabling.
STT_BATCHED_INFERENCE=false
STT_BATCH_SIZE=8

# --- Live transcription (WebSocket /ws/transcribe) ---
# Target amount of trailing audio each interim decode re-transcribes. The window is
# cut at the last committed sentence end and never exceeds min(30, 2x this).
# Note: Whisper pads its input to a fixed 30 s before the encoder, so this does
# NOT change encoder cost. What it bounds is the number of decoder tokens
# regenerated every tick. A real saving, but a moderate one — if decodes are too
# slow, change WHISPER_MODEL_SIZE first. Raising this buys punctuation context.
WS_WINDOW_S=8.0
# Floor on how often a partial can be emitted. The decode is single-flight, so
# this is a floor, not a schedule — decodes never queue behind each other.
WS_MIN_NEW_AUDIO_S=0.5
# Concurrent live sessions admitted before new ones are refused with close 1013.
WS_MAX_SESSIONS=4
# Interim decodes that may fail in a row before the client receives one error
# frame (the session stays open).
WS_MAX_INTERIM_ERRORS=3
# Close a live socket that sent nothing for this many seconds (close code 4408).
# The session holds the model resident, so this also releases it. 0 = never.
WS_IDLE_TIMEOUT_S=60
# With no language fixed, the session locks onto the first detected language once
# its probability reaches this. Raise it if short first words get mis-detected.
WS_LANGUAGE_LOCK_PROB=0.8
# CTranslate2 workers on the shared model. 2 gives live and batch traffic
# independent slots.
WHISPER_NUM_WORKERS=2
# Read by the container entrypoint (start.sh), not by app.py.
#   WS_MAX_QUEUE: audio frames uvicorn buffers per live socket before dropping
#     the connection. The default of 32 is ~2.7 s and too small for a decode burst.
#   KEEPALIVE_TIMEOUT: must stay >= the gateway's UPSTREAM_KEEPALIVE_EXPIRY, or
#     the server closes first and the gateway's pooled sockets come back dead.
#     Raise this whenever you raise that one.
WS_MAX_QUEUE=128
KEEPALIVE_TIMEOUT=120
# Idle-unload TTL for the Whisper weights (1.6 GB for large-v3-turbo, 3.1 GB
# for large-v3). Whisper is the always-on model here, so leaving it pinned made
# the other services' TTLs free memory this one immediately took back.
# Reference counted: a decode in flight is never unloaded underneath itself,
# and the next request reloads transparently.
#   >0 = seconds idle before unloading | 0 = unload when idle | -1 = never
# Set -1 on a card with headroom to avoid paying the reload on a cold request.
STT_MODEL_TTL=300
# Hard cap on retained audio for one session, so a client that streams for an
# hour cannot grow the server buffer without bound. 600 s at 16 kHz mono is
# ~19 MB per session.
WS_MAX_BUFFER_S=600.0
# Hallucination filters for interim results. Whisper invents fluent text from
# silence and room tone; these drop a segment the model itself is unsure about,
# which matters far more on a live stream than on a finished file.
#   no_speech_prob above this  -> discard the segment
#   avg_logprob  below this    -> discard the segment
# Raise WS_NO_SPEECH_THRESHOLD toward 1.0 to filter less, lower it to filter more.
WS_NO_SPEECH_THRESHOLD=0.6
WS_MIN_AVG_LOGPROB=-1.0

# --- GPU inference concurrency (all model services) ---
# One shared model per GPU: these bound concurrent inference so requests queue
# predictably instead of multiplying peak VRAM and slowing each other down.
ASR_MAX_CONCURRENCY=1
TTS_MAX_CONCURRENCY=1
# How many requests may WAIT for one of those slots, and for how long. Without a
# bound a burst of clients piled up in the service until each of them timed out.
# Now a request that finds MAX_CONCURRENCY + MAX_QUEUE requests already admitted is
# answered 503 + Retry-After at once, and one that waited QUEUE_TIMEOUT_S seconds
# without getting its turn is refused the same way. Empty = 4 x the concurrency
# above; 0 = nobody waits (busy means 503). ASR_* applies to Qwen3-ASR, Parakeet and
# Canary; TTS_* to Qwen3-TTS, Chatterbox and Magpie (Piper has its own, PIPER_MAX_CONCURRENCY
# and PIPER_TIMEOUT_S).
ASR_MAX_QUEUE=
ASR_QUEUE_TIMEOUT_S=60
TTS_MAX_QUEUE=
TTS_QUEUE_TIMEOUT_S=60
# Batch size of the Parakeet service. Peak VRAM scales with this, so lower it
# before lowering model size on a card that is tight. (Canary decodes one file
# per pass and does not read it.)
ASR_MAX_BATCH=8
# Same idea for Qwen3-TTS: how many sentences of a long text are generated in
# one forward pass. Without a bound, peak VRAM scaled with the caller's text
# length, so a long enough paragraph could OOM a card that handles short ones.
TTS_MAX_BATCH=8
# Idle-unload TTL applied to any service that does not set its own
# TTS_MODEL_TTL / ASR_MODEL_TTL. This is the single knob that lets several
# multi-GB models share one card.
#   >0 = seconds idle before unloading | 0 = unload as soon as idle | -1 = never
MODEL_TTL=300
# Avoids the allocator fragmentation that per-request empty_cache() used to
# (badly) paper over.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Piper TTS language handling ---
# When the requested language has no matching voice, Piper substitutes an
# English one — so a German request can return ENGLISH AUDIO with HTTP 200.
# The substitution is always reported via the X-Language-Fallback response
# header and a server-side warning. Set this to true to return HTTP 400
# instead, which is usually what an API consumer wants.
PIPER_STRICT_LANGUAGE=false
# Language a request without one (`auto`, or the OpenAI route, which has no such
# field) is spoken in. The service first guesses German vs English from the text
# and uses this when the evidence is thin or no voice for the guess is installed.
PIPER_DEFAULT_LANGUAGE=de
# Set false to always use PIPER_DEFAULT_LANGUAGE instead of guessing from the text.
PIPER_AUTO_DETECT=true
# Voice id preferred for its language when a request names no voice, quality or
# gender, e.g. de_DE-thorsten-medium. Empty = the first installed voice.
PIPER_DEFAULT_VOICE=
# A synthesis running longer than this is killed (HTTP 504); the same bound applies
# to waiting for a free slot (503).
PIPER_TIMEOUT_S=60
# Simultaneous synthesis processes. Empty = half the CPU cores (at least 1).
PIPER_MAX_CONCURRENCY=
# Input bounds (HTTP 422 / 413 beyond them): longest text, largest custom-voice
# model upload and largest /analyze_audio file (MB).
PIPER_MAX_TEXT_CHARS=20000
PIPER_MAX_UPLOAD_MB=100
PIPER_MAX_ANALYZE_UPLOAD_MB=25
# /analyze_audio decodes the whole file, and a few MB of silent FLAC or low-bitrate
# Opus decode to hours: longest recording in seconds (413 beyond it).
PIPER_ANALYZE_MAX_SECONDS=600
# Uploaded (custom) voices are ONNX models run inside the service. At most this many
# (409 beyond it; 0 = no new voice can be uploaded), at most this many MB of them in
# total (413), and how many seconds a new upload gets to load and answer a test
# request in a throw-away process before it is published (400 when it does not).
PIPER_MAX_CUSTOM_VOICES=20
PIPER_MAX_CUSTOM_MB=2048
PIPER_ONNX_VALIDATE_TIMEOUT_S=30
# Build-time, optional and unset by default (the Dockerfile ARGs are the pins):
#   PIPER_VOICES="de_DE-thorsten-medium en_US-lessac-medium"  voices baked into the image
#                                (a fresh install is seeded from them by piper-voices-seed)
#   PIPER_VOICES_REVISION=v1.0.0                              rhasspy/piper-voices revision
# To add a voice to a running install, copy its .onnx and .onnx.json into <models>/default.

# ===========================================
# QWEN3 SERVICES
# ===========================================
# Qwen3-TTS model (voice cloning + TTS)
# 0.6B fits an 8-12 GB card alongside STT (repo labels: 2.5 GB vs 4.5 GB).
# Both variants list German. Raise to the 1.7B only with headroom to spare.
# Built-in speakers (/tts) need a CustomVoice variant such as
# Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice; the Base models clone voices.
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# Language used when a request says `auto` or names none (a name or ISO code).
# `Auto` hands language inference to the model.
QWEN3_DEFAULT_LANGUAGE=German
# auto | sdpa | eager | flash_attention_2. The image ships no flash-attn, so `auto`
# is SDPA; flash_attention_2 needs a custom image.
QWEN3_TTS_ATTN_IMPLEMENTATION=auto
# Longest accepted text (characters) and largest reference-audio upload (MB).
QWEN3_TTS_MAX_TEXT_CHARS=5000
QWEN3_TTS_MAX_UPLOAD_MB=20
# Longest reference clip in seconds (413 beyond it, whatever its file size: a few MB
# of silent FLAC decode to hours). A voice needs 3-10 s.
QWEN3_TTS_REF_MAX_SECONDS=60
# Qwen3-ASR model (speech recognition)
QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# Qwen3-ASR cuts a recording into pieces of this many seconds (5-600) at the
# quietest point near the limit, because the library truncated everything past
# ~2 minutes on its own. Pieces per forward pass bound peak VRAM (lower on OOM).
QWEN3_ASR_CHUNK_S=30
QWEN3_ASR_BATCH_SIZE=4
# Output token limit per piece. Empty = max(512, 20 x QWEN3_ASR_CHUNK_S); a piece
# that reaches it is flagged truncated in the response.
QWEN3_ASR_MAX_NEW_TOKENS=
# Empty = library default (SDPA). sdpa | eager | flash_attention_2 (custom image).
QWEN3_ASR_ATTN_IMPLEMENTATION=
# Build-time, optional and unset by default (the Dockerfile ARGs are the pins, torch 2.8.0
# from the cu128 index). The build fails unless the resulting torch has sm_120 (Blackwell)
# kernels, so set these only to a release that publishes a cu128 wheel:
#   QWEN3_ASR_TORCH_VERSION / QWEN3_ASR_TORCHAUDIO_VERSION
#   QWEN3_TTS_TORCH_VERSION / QWEN3_TTS_TORCHAUDIO_VERSION
# Idle-unload TTL shared by all three ASR services: Qwen3-ASR (~4 GB), Parakeet
# (~3 GB) and Canary (~2 GB). Reference counted, so a transcription in flight is
# never unloaded underneath itself. Whisper has its own knob, STT_MODEL_TTL.
#   >0 = seconds idle | 0 = unload when idle | -1 = never unload
ASR_MODEL_TTL=300

# ===========================================
# PARAKEET-ASR SERVICE (optional, realtime multilingual STT)
# ===========================================
# Heavy NeMo image — opt-in. Start with `--profile parakeet-asr` and set
# ENABLE_PARAKEET_ASR=true so the backend appears in the browser UI.
ENABLE_PARAKEET_ASR=false
# A Hugging Face id, an NGC name or the path of a .nemo file on a mounted volume
# (e.g. a German fine-tune such as primeline/parakeet-primeline, CC-BY-4.0).
PARAKEET_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3

# ===========================================
# CANARY-ASR SERVICE (optional, fastest German/EU STT)
# ===========================================
# Heavy NeMo image — opt-in. Start with `--profile canary-asr` and set
# ENABLE_CANARY_ASR=true so the backend appears in the browser UI.
ENABLE_CANARY_ASR=false
CANARY_ASR_MODEL=nvidia/canary-180m-flash
# Used when a request says language=auto (Canary has no language detection)
CANARY_DEFAULT_LANGUAGE=de
# Comma/space separated language codes to accept instead of the table derived from
# CANARY_ASR_MODEL (en,de,es,fr for the flash models, 25 for canary-1b-v2). A
# language the model cannot decode is refused with 422 instead of decoded as German.
CANARY_SUPPORTED_LANGUAGES=

# ===========================================
# NEMO (Parakeet + Canary) INFERENCE AND BUILD
# ===========================================
# Longest recording in seconds (413 beyond it, 0 = unlimited). NeMo encodes a file in
# one pass; about 24 minutes is parakeet-tdt-0.6b-v3's full-attention limit.
NEMO_MAX_AUDIO_S=1500
# torch.set_float32_matmul_precision at model load: highest | high | medium.
NEMO_MATMUL_PRECISION=high
# Opt-in bfloat16 inference, NVIDIA compute capability 8.0+ only (ignored on CPU,
# ROCm and older GPUs). German WER has not been re-measured with it.
NEMO_BF16=false
# The CUDA images are built on NeMo 3.0.x and torch 2.11 (cu128). Build-time only,
# all optional and unset by default (the Dockerfile ARGs are the pins):
#   NEMO_TOOLKIT_SPEC='>=2.7.3,<3'   roll back to NeMo 2.x:
#       NEMO_TOOLKIT_SPEC='>=2.7.3,<3' docker compose build parakeet-asr-service canary-asr-service
#   NEMO_TOOLKIT_SPEC='>=3.0.0,<4'   accept later 3.x releases
#   NEMO_TORCH_VERSION / NEMO_TORCHAUDIO_VERSION   only releases that have a cu128
#                                    wheel (PyTorch publishes cu128 for 2.7 - 2.11)
# For a rollback with prebuilt images set NEMO_IMAGE_SUFFIX=-nemo2 above. They are
# published for release tags only (X.Y.Z-nemo2, and latest-nemo2 from the newest
# release), not for every master build, so pair the suffix with a pinned IMAGE_TAG.

# ===========================================
# CHATTERBOX-TTS SERVICE (optional, multilingual TTS + cloning, MIT)
# ===========================================
# Opt-in. Start with `--profile chatterbox-tts` and set
# ENABLE_CHATTERBOX_TTS=true so the engine appears in the browser UI.
ENABLE_CHATTERBOX_TTS=false
CHATTERBOX_DEFAULT_LANGUAGE=de
# T3 checkpoint: v3 (multilingual v3, needs the GitHub build the image installs),
# v2, default (the library's own) or a .safetensors file name. A package without
# t3_model support falls back to its default checkpoint and logs a warning.
CHATTERBOX_T3_MODEL=v3
# Empty = the library default (2.0 in 0.1.7, 1.2 on master). Must be >= 1.
CHATTERBOX_REPETITION_PENALTY=
# Hugging Face revision (branch, tag or commit) of the ResembleAI/chatterbox weights.
CHATTERBOX_HF_REVISION=main
# Silence between the chunks one response is generated in (0 = none) and how much
# of an uploaded clone reference is used, in seconds.
CHATTERBOX_CHUNK_GAP_MS=150
CHATTERBOX_REF_MAX_SECONDS=30
# Longest accepted text (413 beyond it; the audio used to be cut at ~40 s silently)
# and largest reference upload in MB. The gateway's MAX_TTS_CHARS is larger.
CHATTERBOX_MAX_TEXT_CHARS=5000
CHATTERBOX_MAX_UPLOAD_MB=20
# Build-time, optional and unset by default (the Dockerfile ARGs are the pins):
#   CHATTERBOX_REF=<commit>   chatterbox git commit to install (v3 exists on GitHub
#                             master only; PyPI 0.1.7 has no t3_model)
#   CHATTERBOX_REPO=<url>     alternative git remote
#   CHATTERBOX_TORCH_VERSION / CHATTERBOX_TORCHAUDIO_VERSION  cu128 torch pair
# Idle-unload TTL for the Chatterbox model (~4 GB). This is what lets it share
# a 12 GB card with the STT/ASR stack, which already occupies ~9.7 GB.
# Reference counted, so a generation in flight is never unloaded.
#   >0 = seconds idle before unloading | 0 = unload immediately | -1 = never
# Set -1 on a card with spare VRAM to avoid the reload latency.
TTS_MODEL_TTL=300

# ===========================================
# MAGPIE-TTS SERVICE (optional, NVIDIA multilingual TTS, 5 built-in voices)
# ===========================================
# Opt-in. Start with `--profile magpie-tts` and set ENABLE_MAGPIE_TTS=true so the
# engine appears in the browser UI. NVIDIA Open Model License (a custom license: read it
# before relying on it). No voice cloning, no streaming; about 4.2 GB of VRAM measured
# on an RTX 4080, and a first start downloads about 2.5 GB (the model, its audio codec
# and two helper models). TTS_MODEL_TTL (below the Chatterbox section) applies to it too.
ENABLE_MAGPIE_TTS=false
# What "auto" means. NeMo 3.0.x speaks de, en, es, fr, ja and zh; any other language
# is refused with a 400 (NeMo itself would read it with English rules and answer 200).
MAGPIE_DEFAULT_LANGUAGE=de
# Aria, Jason, John, Leo or Sofia (or an index 0-4).
MAGPIE_DEFAULT_SPEAKER=Sofia
# More languages to warm when the model loads, comma-separated (e.g. en,fr). The first
# request in a language builds its text normalizer: measured 12 s de, 18 s en, 37 s fr,
# 48 s es; later requests in it are ordinary. Warming moves that wait from a user to the
# start (/ready answers 503 "loading" meanwhile). The default language is always warmed.
MAGPIE_WARM_LANGUAGES=
# Text normalization (numbers, dates, times become words). Off, the model's tokenizer
# silently drops every digit: "12,50 Euro um 14:30 Uhr" would be read as "Euro um Uhr".
MAGPIE_APPLY_TN=true
# Classifier-free guidance: better speech for roughly twice the compute.
MAGPIE_USE_CFG=true
# Long text is generated in groups of whole sentences of at most this many characters
# (NeMo's own chunking left audible defects) joined with MAGPIE_GROUP_GAP_MS of silence.
MAGPIE_MAX_GROUP_CHARS=200
MAGPIE_GROUP_GAP_MS=150
# Longest accepted text (413 beyond it). The gateway's MAX_TTS_CHARS is larger.
MAGPIE_MAX_TEXT_CHARS=5000
# A Hugging Face id, an NGC name, or the path of a .nemo file on a mounted volume.
# MAGPIE_MODEL=nvidia/magpie_tts_multilingual_357m

# ===========================================
# WHISPER-CPP SERVICE (optional, OpenAI-compatible STT)
# ===========================================
# Opt-in. Start with `--profile whisper-cpp` and set ENABLE_WHISPER_CPP=true
# so the backend appears in the browser UI.
ENABLE_WHISPER_CPP=false
# ggml model name downloaded on first start: tiny | base | small | medium |
# large-v1 | large-v2 | large-v3 | large-v3-turbo
# Quantised builds exist only for SOME sizes — a wrong name fails at startup:
#   large-v3-turbo-q5_0 | large-v3-turbo-q8_0 | small-q5_1 | base-q5_1
# ('small'/'base' have no q5_0.) q5_0 turbo is the sensible default on x86;
# on an ARM SBC (RK3588) use small-q5_1 — turbo is slower than real time there.
WHISPER_MODEL=large-v3-turbo-q5_0
# Optional extra whisper-server CLI flags (e.g. "--language de --threads 4")
WHISPER_CPP_EXTRA_ARGS=
# Build-time, optional: WHISPER_CPP_REF=<tag> compiles another whisper.cpp release
# (unset = the pin in whisper-cpp-service/Dockerfile*; docker compose build only,
# the published images use the Dockerfile pin).

# ===========================================
# VOICE TRAINING SERVICE
# ===========================================
# PyTorch CUDA memory for training (larger allocation for training)
TRAINING_PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:1024
# OpenMP thread count for CPU operations
OMP_NUM_THREADS=4
# Hard cap on VITS training batch size (raise if you have spare GPU memory).
# OOM still triggers automatic batch-size reduction regardless of this value.
MAX_TRAIN_BATCH_SIZE=4
# The training service transcribes uploads through the STT service to segment
# them. STT_SERVICE_URL (above) is the only place that address comes from; a
# `stt_service_url` form field on /train is accepted only when it matches.
# Setting this to true honours the field instead, which lets any caller point
# the service at a host of their choosing — leave it off unless you need it.
ALLOW_CLIENT_STT_URL=false
# Jobs that may run at once. A second job is refused with 409 naming the running one.
TRAINING_MAX_CONCURRENT=1
# Dataset language when a request names none (de, en, fr, es, it, nl, pt, ru).
TRAINING_DEFAULT_LANGUAGE=de
# /prepare-dataset reads audio only from data/ plus these in-container directories
# (comma separated) and downloads only from these hosts; URLs are refused when empty.
TRAINING_ALLOWED_AUDIO_DIRS=
TRAINING_ALLOWED_URL_HOSTS=
# Transcript segments whose exp(avg_logprob) is below this are not trained on
# (0 keeps everything), and the share of samples that may fail phonemisation
# before a dataset build aborts.
STT_MIN_CONFIDENCE=0.6
PHONEMIZER_MAX_FAILURE_FRACTION=0.05
# A job fails after this many batches in a row that produced no update. Periodic
# checkpoints (~200 MB each) kept per job: best_model.pt and final_model.pt are never
# pruned, 0 keeps every one.
TRAIN_MAX_CONSECUTIVE_FAILURES=5
KEEP_LAST_CHECKPOINTS=5
# DataLoader worker processes (0 = load in the training thread, e.g. with a tiny /dev/shm).
TRAIN_NUM_WORKERS=2
# Shutdown waits this long for running jobs to stop at an epoch boundary. The
# container's stop_grace_period (60 s) must stay larger or Docker kills it first.
TRAINING_SHUTDOWN_GRACE_S=30
# Idle keep-alive of the training service; keep it >= UPSTREAM_KEEPALIVE_EXPIRY (115).
UVICORN_TIMEOUT_KEEP_ALIVE=120
# Largest /train upload in MB, and longest segment transcript in characters.
TRAINING_MAX_UPLOAD_MB=500
TRAINING_MAX_TEXT_CHARS=1000
# Optional caps so a runaway job cannot take the host down. 0 = unlimited.
# Examples: TRAINING_MEM_LIMIT=12g  TRAINING_CPUS=6
TRAINING_MEM_LIMIT=0
TRAINING_CPUS=0

# ===========================================
# PIPER TTS SERVICE
# ===========================================
# Generated default-voice WAVs are pruned after this many hours (0 = keep all)
OUTPUT_RETENTION_HOURS=24
# How often the pruner runs, in seconds.
OUTPUT_PRUNE_INTERVAL_S=3600
# Where generated audio is written, and where voice models are read from
# (both inside the container). Change these only if you also remap the volumes.
# PIPER_OUTPUT_DIR=/app/output
# PIPER_DATA_DIR=/app/models

# Piper is CPU-only ONNX, so these two decide its throughput. They matter most
# on the RK3588S, which is the one target with no GPU at all.
#   ONNX_NUM_THREADS: intra-op threads per synthesis. The RK3588S has 4x A76 +
#     4x A55; 4 uses the big cores without oversubscribing. Going wider than the
#     big-core count usually costs more in scheduling than it gains.
ONNX_NUM_THREADS=2
#   ONNX_SESSION_CACHE_SIZE: how many voice models stay loaded. Each is only a
#     few tens of MB, so raise this if you switch voices often; the cost of a
#     miss is re-reading and re-initialising the ONNX session.
ONNX_SESSION_CACHE_SIZE=4

# ===========================================
# WEB INTERFACE, ACCESS CONTROL & CORS
# ===========================================
# The browser only ever talks to the gateway on FRONTEND_PORT. It proxies /api/*,
# /api/health and the /ws/stt relay to the backends over the internal Docker
# network, so no backend port needs publishing — including when you open the UI
# from another machine. (There are no browser-facing backend URLs to configure.)
#
# Which pages may call the gateway's API from a browser. Empty = the UI's own
# origin only: no CORS headers, and a state-changing request that carries a
# foreign Origin is refused with 403. List origins (comma separated) to allow
# other pages, e.g. https://voice.example.com; `*` opens it to any web page
# (logged as a warning). Opening the UI by another origin name is NOT covered by
# this (see TRUSTED_HOSTS below): this is for OTHER pages calling the API.
ALLOWED_ORIGINS=
ALLOW_CREDENTIALS=false
# Origins that are this UI under another name: set when a reverse proxy rewrites
# the Host header. Symptom of a missing entry: 403 on every button. The hostname of
# each entry is trusted as a Host too. Believe X-Forwarded-Host (instead of Host)
# only when the proxy is trusted and overwrites it.
TRUSTED_ORIGINS=
TRUST_PROXY_HEADERS=false
# Host names this UI may be reached by (DNS-rebinding guard): a request whose Host
# header names anything else gets 403 host_not_allowed. Not needed for an IP address
# (192.168.1.20, a Tailscale 100.x address), localhost, *.local, *.lan, *.internal,
# *.home.arpa, *.localdomain or a single-label name (truenas). REQUIRED for a real
# domain, e.g. behind a reverse proxy that passes Host through, and for a MagicDNS
# name. Comma separated, `*.` wildcard for a whole domain, ports and case ignored:
#   TRUSTED_HOSTS=tts.example.com,*.tail1234.ts.net
TRUSTED_HOSTS=
# `*` switches the Host check off (every name is accepted, a rebinding page too).
# Nothing else is read from it; list names in TRUSTED_HOSTS. Leave empty.
ALLOWED_HOSTS=
# Optional shared secret. Empty = open, which is fine on a trusted LAN. When set,
# /v1/* needs `Authorization: Bearer <key>`, and so do state-changing /api/* calls
# and the /ws/stt live-transcription upgrade. There is NO exemption for the bundled
# UI (Origin, Host and Sec-Fetch-Site are what a rebinding page controls): the UI
# asks for the key once with a browser prompt and keeps it in sessionStorage (this
# tab only). It is a shared secret, not user authentication, and over plain http it
# crosses the network unencrypted.
API_KEY=
# Largest request body in MB for uploads through the gateway (training audio, voice
# samples, STT files), and longest text in characters for TTS. Beyond either: 413 / 422.
# Keep MAX_TTS_CHARS <= the smallest text limit of the TTS backends in use (Qwen3-TTS
# and Chatterbox accept 5000); a Piper-only setup (limit 20000) can raise it.
MAX_UPLOAD_MB=512
MAX_TTS_CHARS=5000
# Per gateway worker process: uploads forwarded at the same time (the next one is
# answered 503 + Retry-After before its body is read) and ffmpeg conversions for
# /v1/audio/speech (mp3, resampled pcm; 503 + Retry-After beyond it). Worst-case
# upload memory = FRONTEND_WORKERS x MAX_CONCURRENT_UPLOADS x MAX_UPLOAD_MB.
MAX_CONCURRENT_UPLOADS=4
MAX_CONCURRENT_FFMPEG=4
# Seconds a GET /api/health result is reused (0 = always probe every backend).
HEALTH_CACHE_TTL=2
# uvicorn worker processes of the gateway; ~160 MB each. Use 1 on an SBC.
FRONTEND_WORKERS=2

# The backends are not browser-facing (the gateway is), so their CORS is CLOSED by
# default (empty = no CORS headers), and state-changing requests that carry a foreign
# Origin header are refused. Only if you call a published backend port from a browser
# page (BACKEND_BIND_ADDR) list the origins here; '*' opens it to every page and is
# logged as a warning by each service.
BACKEND_ALLOWED_ORIGINS=

# Which backend the UI preselects. Must be a provider id from GET /providers.
DEFAULT_STT_PROVIDER=whisper
DEFAULT_TTS_PROVIDER=piper

# Per-provider timeout for GET /api/health, in seconds. Probes run concurrently,
# so this bounds the whole health call, not each one in sequence.
PROVIDER_HEALTH_TIMEOUT=6

# Upstream connection pool for the proxy. KEEPALIVE_EXPIRY must stay BELOW the
# backends' keep-alive timeout, or the gateway hands out sockets the backend has
# already closed and requests fail with a bare disconnect.
UPSTREAM_MAX_CONNECTIONS=100
UPSTREAM_MAX_KEEPALIVE=20
UPSTREAM_KEEPALIVE_EXPIRY=115

# ===========================================
# OPTIONAL DEVELOPMENT SETTINGS
# ===========================================
ENVIRONMENT=production

# ===========================================
# INTERNAL WIRING (set by compose — listed for completeness)
# ===========================================
# These are read by the services but set for you in docker-compose.yml. They are
# documented here only so that `grep` for a variable you saw in a log finds it.
# Override them only when running a service outside compose.
#
#   Service discovery, all Docker-network names (services reach each other by name
#   on the compose network, never through the published host ports above):
#     TTS_SERVICE_URL, STT_SERVICE_URL, QWEN3_TTS_SERVICE_URL,
#     QWEN3_ASR_SERVICE_URL, PARAKEET_ASR_SERVICE_URL, CANARY_ASR_SERVICE_URL,
#     CHATTERBOX_TTS_SERVICE_URL, WHISPER_CPP_SERVICE_URL, VOICE_TRAINING_URL,
#     PIPER_TTS_SERVICE_URL
#   Paths inside the containers, derived from APP_DATA_DIR:
#     SHARED_MODELS_DIR, VOICES_DIR
#   Shown in the UI footer, stamped at build time:
#     APP_VERSION
#
# Advanced overrides. Compose forwards them (empty = built-in behaviour). In the two
# JSON ones an entry with the same id replaces the built-in entry as a whole (there
# is no deep merge), and malformed JSON stops the service from starting (it restarts
# in a loop until the value is fixed). Multi-line JSON does not survive a .env file:
# set them in the shell or an override file.
#   PROVIDER_REGISTRY_JSON     JSON whose "providers" / "ui" entries replace the
#                              gateway's built-in provider registry entries
#   DEPLOYMENT_TARGETS_JSON    JSON whose "targets" entries replace the training
#                              service's deployment targets
#   TRAINING_PROVIDER          provider id that owns training (default piper-training)
#   DEFAULT_DEPLOYMENT_TARGET  which target the training UI preselects
