########################################
# TTS-STT Services Configuration        #
########################################

# ===========================================
# HOST PORT CONFIGURATION
# ===========================================
# Change these if ports conflict with other services on your machine
FRONTEND_PORT=3000
PIPER_TTS_PORT=5000
STT_PORT=5001
QWEN3_ASR_PORT=5002
QWEN3_TTS_PORT=5004
PARAKEET_ASR_PORT=5005
TRAINING_PORT=8080

# ===========================================
# CONTAINER IMAGES
# ===========================================
# Where prebuilt images are pulled from (and tagged when building locally).
# Published by CI to GHCR. Override to use your own registry/fork.
IMAGE_REGISTRY=ghcr.io/steffenhebestreit
IMAGE_TAG=latest

# ===========================================
# STORAGE / DATA LOCATION
# ===========================================
# Where persistent data lives on the host. Leave APP_DATA_DIR empty for local
# dev (data stays under the repo). On TrueNAS/servers, point it at a dataset and
# every data dir below moves there automatically, e.g.:
#   APP_DATA_DIR=/mnt/pool/apps/tts-stt
APP_DATA_DIR=
# Fine-grained overrides (default to ${APP_DATA_DIR}/<name>). Usually leave blank.
# MODELS_DIR=
# OUTPUT_DIR=
# CACHE_DIR=
# TRAINING_DATA_DIR=
# TRAINING_CHECKPOINTS_DIR=
# TRAINING_MODELS_DIR=
# TRAINING_CONFIGS_DIR=
# Model-download caches default to named Docker volumes; set to a dataset path to
# keep multi-GB Hugging Face downloads on your pool instead of the docker root.
# QWEN3_TTS_CACHE_DIR=
# QWEN3_ASR_CACHE_DIR=
# PARAKEET_ASR_CACHE_DIR=
# QWEN3_TTS_VOICES_DIR=
# WHISPER_CPP_MODELS_DIR=

# ===========================================
# HARDWARE ACCELERATION
# ===========================================
# GPU device selection (0 for first GPU, 1 for second, etc.)
CUDA_VISIBLE_DEVICES=0
# Docker-visible GPU set. For single-GPU TrueNAS custom-app deployments, keep this aligned with CUDA_VISIBLE_DEVICES.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Optional override: cuda | rocm | cpu (leave empty to auto-detect)
FORCE_ACCELERATION=

# --- ROCm / AMD GPU (used with docker-compose.rocm.yml) ---
# AMD GPU device index
HIP_VISIBLE_DEVICES=0
# GFX version override for unsupported AMD GPUs (e.g. Strix Halo gfx1201 → 11.0.0)
# Leave empty if your GPU is natively supported by ROCm 6.2
HSA_OVERRIDE_GFX_VERSION=

# ===========================================
# STT SERVICE (Whisper Speech-to-Text)
# ===========================================
# Whisper model size: tiny | base | small | medium | large-v3
# tiny: ~39MB, fast but lower accuracy
# base: ~74MB, balanced speed/accuracy
# small: ~244MB, good accuracy
# medium: ~769MB, high accuracy
# large-v3: ~1550MB, best accuracy
WHISPER_MODEL_SIZE=small

# ===========================================
# QWEN3 SERVICES
# ===========================================
# Qwen3-TTS model (voice cloning + TTS)
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# Qwen3-ASR model (speech recognition)
QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B

# ===========================================
# PARAKEET-ASR SERVICE (optional, realtime multilingual STT)
# ===========================================
# Heavy NeMo image — opt-in. Start with `--profile parakeet-asr` and set
# ENABLE_PARAKEET_ASR=true so the backend appears in the browser UI.
ENABLE_PARAKEET_ASR=false
PARAKEET_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3

# ===========================================
# VOICE TRAINING SERVICE
# ===========================================
# PyTorch CUDA memory for training (larger allocation for training)
TRAINING_PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:1024
# OpenMP thread count for CPU operations
OMP_NUM_THREADS=4
# Hard cap on VITS training batch size (raise if you have spare GPU memory).
# OOM still triggers automatic batch-size reduction regardless of this value.
MAX_TRAIN_BATCH_SIZE=4

# ===========================================
# PIPER TTS SERVICE
# ===========================================
# Generated default-voice WAVs are pruned after this many hours (0 = keep all)
OUTPUT_RETENTION_HOURS=24

# ===========================================
# WEB INTERFACE & CORS
# ===========================================
# Comma-separated list of allowed origins; set to specific URLs for production
ALLOWED_ORIGINS=*
ALLOW_CREDENTIALS=false
# Browser-visible backend URLs. Change these when the frontend is opened from another machine.
BROWSER_TTS_URL=http://localhost:5000
BROWSER_STT_URL=http://localhost:5001
BROWSER_TRAINING_URL=http://localhost:8080
BROWSER_QWEN3_ASR_URL=http://localhost:5002
BROWSER_QWEN3_TTS_URL=http://localhost:5004
BROWSER_PARAKEET_ASR_URL=http://localhost:5005

# ===========================================
# OPTIONAL DEVELOPMENT SETTINGS
# ===========================================
ENVIRONMENT=production
