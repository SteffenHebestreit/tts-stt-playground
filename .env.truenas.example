########################################
# TTS-STT TrueNAS SCALE Preset         #
########################################

# Copy to .env on the TrueNAS host when deploying this stack on a
# dedicated NVIDIA RTX 5060 Ti 16 GB system.

# ===========================================
# HOST PORTS
# ===========================================
FRONTEND_PORT=3000
PIPER_TTS_PORT=5000
STT_PORT=5001
QWEN3_ASR_PORT=5002
WHISPER_CPP_PORT=5003
QWEN3_TTS_PORT=5004
PARAKEET_ASR_PORT=5005
TRAINING_PORT=8080

# ===========================================
# STORAGE / DATASET
# ===========================================
# Point all persistent data (models, output, caches, training data) at a
# TrueNAS dataset. Create the dataset first, e.g. /mnt/pool/apps/tts-stt.
APP_DATA_DIR=/mnt/pool/apps/tts-stt
# Keep multi-GB Hugging Face model caches on the pool too (otherwise they land
# in the docker root). Uncomment to relocate; defaults are named Docker volumes.
# QWEN3_TTS_CACHE_DIR=/mnt/pool/apps/tts-stt/hf-cache/qwen3-tts
# QWEN3_ASR_CACHE_DIR=/mnt/pool/apps/tts-stt/hf-cache/qwen3-asr
# PARAKEET_ASR_CACHE_DIR=/mnt/pool/apps/tts-stt/hf-cache/parakeet
# WHISPER_CPP_MODELS_DIR=/mnt/pool/apps/tts-stt/whisper-cpp-models

# ===========================================
# NVIDIA GPU / CUDA
# ===========================================
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
FORCE_ACCELERATION=cuda

# ===========================================
# MODEL SELECTION (16 GB VRAM BALANCED)
# ===========================================
# Use medium Whisper by default to leave headroom for Qwen services.
WHISPER_MODEL_SIZE=medium
WHISPER_MODEL=large-v3

# Qwen3-TTS: use the 0.6B variant by default on 16 GB when other GPU services
# may run alongside it.
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B

# ===========================================
# PARAKEET-ASR (optional realtime multilingual STT)
# ===========================================
# Opt-in: start with `--profile parakeet-asr` and flip the flag to expose it in
# the browser UI. Heavy NeMo image; competes for VRAM with the Qwen services.
ENABLE_PARAKEET_ASR=false
PARAKEET_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3

# ===========================================
# TRAINING / TORCH MEMORY
# ===========================================
TRAINING_PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
OMP_NUM_THREADS=4
# Hard cap on VITS training batch size (raise if you have spare VRAM).
MAX_TRAIN_BATCH_SIZE=4
# Prune generated default-voice WAVs older than this many hours (0 = keep all).
OUTPUT_RETENTION_HOURS=24

# ===========================================
# CORS / WEB
# ===========================================
# Set explicit origins in production if the frontend is reverse-proxied behind
# a custom hostname. Keep credentials disabled unless you need cookies/auth.
ALLOWED_ORIGINS=*
ALLOW_CREDENTIALS=false

# ===========================================
# INTERNAL URLS
# ===========================================
STT_SERVICE_URL=http://stt-service:8000

# ===========================================
# OPTIONAL NOTES
# ===========================================
# 1. Launch with:
#    docker compose -f docker-compose.yml -f docker-compose.truenas.yml --profile all up -d
# 2. If you plan to train while Qwen3-TTS and Qwen3-ASR are active, consider
#    stopping one of them temporarily to leave more VRAM headroom.