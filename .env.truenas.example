########################################
# TTS-STT TrueNAS SCALE settings       #
########################################

# You do NOT need this file to paste docker-compose.truenas-app.yml into the Apps UI:
# there you change the ${NAME:-default} texts inside the YAML instead.
#
# Use this file when you want the settings in ONE place that survives edits:
#
#   A. Custom App with a settings file (guide: "Settings file"). The pasted YAML shrinks to
#      an include: of docker-compose.truenas-app.yml with this file as env_file, so an
#      update is one changed line here.
#   B. Build from source on the NAS (docker-compose.yml + docker-compose.truenas.yml):
#        cp .env.truenas.example .env
#
# Sized for one NVIDIA card. Check what your card actually has with:
#   nvidia-smi --query-gpu=name,memory.total --format=csv
# and what the stack needs with: scripts/truenas/preflight.sh --data-dir <APP_DATA_DIR>

# ===========================================
# RELEASE
# ===========================================
# The release to run. scripts/truenas/set_version.py keeps this in step with
# truenas/tts-stt/app.yaml, the compose files and the docs.
IMAGE_TAG=0.2.0
# missing = pull only images the host does not have (pinned release).
# always  = pull on every start; use with IMAGE_TAG=latest to follow the newest build.
PULL_POLICY=missing
# The NeMo services (canary, parakeet) run NeMo 3.x. A rollback image built against
# NeMo 2.x is published as <release>-nemo2: set NEMO_IMAGE_SUFFIX=-nemo2 to use it.
# NEMO_IMAGE_SUFFIX=

# ===========================================
# STORAGE
# ===========================================
# The dataset that holds models, cache, voices and output. Create it first
# (Datasets -> Add Dataset). Replace the placeholder with its real path.
APP_DATA_DIR=/mnt/pool/apps/tts-stt

# ===========================================
# GPU
# ===========================================
# Custom App route: which card, as an index or GPU-xxxx UUID from `nvidia-smi -L`.
# (The from-source overlay always uses card 0.)
GPU_DEVICE_ID=0

# ===========================================
# PORTS
# ===========================================
# Only the web UI is published. Backends stay on the internal network.
FRONTEND_PORT=3000
# From-source route only: backend ports bind to 127.0.0.1 (this host) by default.
# BACKEND_BIND_ADDR=127.0.0.1

# ===========================================
# MODELS
# ===========================================
# large-v3-turbo: best latency/accuracy trade, cannot translate. large-v3 can (~1.5 GB more VRAM).
WHISPER_MODEL_SIZE=large-v3-turbo
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B

# ===========================================
# OPTIONAL SERVICES
# ===========================================
# Two steps per service: enable it (delete its `profiles:` line in the Custom App YAML,
# or --profile <name> when building from source) AND set its flag here so the UI shows it.
# Each one adds VRAM: see docs/truenas-installation-guide.md.
ENABLE_CANARY_ASR=false
ENABLE_PARAKEET_ASR=false
ENABLE_CHATTERBOX_TTS=false
ENABLE_MAGPIE_TTS=false
ENABLE_WHISPER_CPP=false
PARAKEET_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3

# ===========================================
# TRAINING / TORCH MEMORY
# ===========================================
TRAINING_PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
OMP_NUM_THREADS=4
# Hard cap on VITS training batch size (raise if you have spare VRAM).
MAX_TRAIN_BATCH_SIZE=4
# Prune generated default-voice WAVs older than this many hours (0 = keep all).
OUTPUT_RETENTION_HOURS=24

# ===========================================
# WEB ACCESS
# ===========================================
# Empty = same-origin only: right for the web UI, over http://<ip>:3000 as well.
# Put origins here (comma separated) only for scripts running in OTHER web pages.
ALLOWED_ORIGINS=
ALLOW_CREDENTIALS=false
# Names the UI may be reached by. An IP address (http://192.168.1.20:3000), localhost,
# *.local, *.lan, *.internal and a plain name such as http://truenas:3000 need nothing.
# A real domain (a reverse proxy in front) or a Tailscale name does: list it here,
# comma separated (voice.example.com,*.tail1234.ts.net), or every request answers
# 403 host_not_allowed. See docs/truenas-installation-guide.md, "Troubleshooting".
TRUSTED_HOSTS=
# Optional shared secret. Empty = open, fine on a trusted LAN. When set, /v1/*, mutating
# /api/* calls and the live-transcription socket need `Authorization: Bearer <key>`; the
# web UI asks for it once per browser tab (there is no exemption for it).
# API_KEY=

# ===========================================
# NOTES
# ===========================================
# 1. Training: with several inference services resident, stop qwen3-tts-service first.
# 2. Behind an HTTPS reverse proxy, see .env.truenas.production.example.
