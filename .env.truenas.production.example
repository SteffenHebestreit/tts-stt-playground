########################################
# TTS-STT TrueNAS production settings  #
########################################

# Same variables as .env.truenas.example (read its header for how to use the file), tightened
# for a box that is reached through a reverse proxy or from outside the LAN. Copy the
# values you need over; you do not have to use this file as it is.

# ===========================================
# RELEASE: pinned, reproducible
# ===========================================
IMAGE_TAG=0.2.0
PULL_POLICY=missing

# ===========================================
# STORAGE
# ===========================================
# Replace with the path of your dataset (create it first).
APP_DATA_DIR=/mnt/pool/apps/tts-stt

# ===========================================
# GPU
# ===========================================
GPU_DEVICE_ID=0

# ===========================================
# PORTS
# ===========================================
FRONTEND_PORT=3000
# Behind a proxy on this same host, listen on loopback only so nothing bypasses it:
# FRONTEND_BIND_ADDR=127.0.0.1

# ===========================================
# MODELS (one NVIDIA card; check its VRAM with nvidia-smi)
# ===========================================
WHISPER_MODEL_SIZE=large-v3-turbo
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B

# ===========================================
# OPTIONAL SERVICES
# ===========================================
ENABLE_CANARY_ASR=false
ENABLE_PARAKEET_ASR=false
ENABLE_CHATTERBOX_TTS=false
ENABLE_WHISPER_CPP=false

# ===========================================
# TRAINING / TORCH MEMORY
# ===========================================
TRAINING_PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
OMP_NUM_THREADS=4
MAX_TRAIN_BATCH_SIZE=4
OUTPUT_RETENTION_HOURS=24

# ===========================================
# WEB ACCESS BEHIND A REVERSE PROXY
# ===========================================
# The proxy has to forward the WebSocket upgrade (/ws/stt) and must not buffer responses;
# see docs/truenas-installation-guide.md, "Reverse proxy". HTTPS is required for the
# microphone from any machine other than the NAS.
#
# ALLOWED_ORIGINS stays empty: the browser and the UI are the same origin. It is only for
# scripts in other web pages.
ALLOWED_ORIGINS=
ALLOW_CREDENTIALS=false
# The public URL of the proxy. Needed when the proxy does not pass the original Host header;
# the symptom without it is a 403 on every button.
TRUSTED_ORIGINS=https://voice.example.com
# Believe X-Forwarded-Host from the proxy (turn on only if the proxy sets it).
TRUST_PROXY_HEADERS=false
# Optional shared secret for /v1/* and mutating /api/* calls from scripts. Empty = open.
# It is not user authentication: same-origin browser requests do not need it.
API_KEY=
