########################################
# TTS-STT TrueNAS Production Template  #
########################################

# Replace the example hostname and pool path notes below with your real values.
# Recommended repo location on the TrueNAS host:
#   /mnt/pool/apps/tts-stt

# ===========================================
# PUBLIC HOST / PORTS
# ===========================================
FRONTEND_PORT=3000
PIPER_TTS_PORT=5000
STT_PORT=5001
QWEN3_ASR_PORT=5002
WHISPER_CPP_PORT=5003
QWEN3_TTS_PORT=5004
PARAKEET_ASR_PORT=5005
TRAINING_PORT=8080

# Persistent data dataset on the TrueNAS host (create it first).
APP_DATA_DIR=/mnt/pool/apps/tts-stt

# Browser-facing URLs consumed by the frontend service.
# If you expose services directly by host port, use hostnames like below.
BROWSER_TTS_URL=http://truenas.local:5000
BROWSER_STT_URL=http://truenas.local:5001
BROWSER_TRAINING_URL=http://truenas.local:8080
BROWSER_QWEN3_ASR_URL=http://truenas.local:5002
BROWSER_QWEN3_TTS_URL=http://truenas.local:5004
BROWSER_PARAKEET_ASR_URL=http://truenas.local:5005

# ===========================================
# NVIDIA GPU / CUDA
# ===========================================
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
FORCE_ACCELERATION=cuda

# ===========================================
# MODEL SELECTION (RTX 5060 Ti 16 GB)
# ===========================================
WHISPER_MODEL_SIZE=medium
WHISPER_MODEL=large-v3
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B

# Optional realtime multilingual STT (start with --profile parakeet-asr).
ENABLE_PARAKEET_ASR=false
PARAKEET_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3

# ===========================================
# TRAINING / TORCH MEMORY
# ===========================================
TRAINING_PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
OMP_NUM_THREADS=4
MAX_TRAIN_BATCH_SIZE=4
OUTPUT_RETENTION_HOURS=24

# ===========================================
# CORS / WEB
# ===========================================
# Set this to the exact frontend origin you will open in the browser.
ALLOWED_ORIGINS=http://truenas.local:3000
ALLOW_CREDENTIALS=false

# ===========================================
# INTERNAL URLS
# ===========================================
STT_SERVICE_URL=http://stt-service:8000

# ===========================================
# OPERATIONAL NOTES
# ===========================================
# 1. Place the repo under your TrueNAS dataset path, for example:
#      /mnt/pool/apps/tts-stt
# 2. Launch with:
#      docker compose --env-file .env -f docker-compose.yml -f docker-compose.truenas.yml --profile all up -d
# 3. For training windows, consider stopping qwen3-tts-service first.