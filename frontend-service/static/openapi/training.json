            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/status/{job_id}": {
      "get": {
        "summary": "Get Training Status",
        "description": "Return the current status of a training job.",
        "operationId": "get_training_status_status__job_id__get",
