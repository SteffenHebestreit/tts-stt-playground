              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/generate-missing-mels": {
      "post": {
        "summary": "Generate Missing Mels",
        "description": "Generate mel spectrograms for audio files that are missing them.",
        "operationId": "generate_missing_mels_generate_missing_mels_post",
        "parameters": [
          {
            "name": "model_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "stst",
              "title": "Model Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/prepare-dataset": {
      "post": {
        "summary": "Prepare Dataset",
        "description": "Create a training dataset from pre-segmented STT results.",
        "operationId": "prepare_dataset_prepare_dataset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DatasetUpload"
              }
