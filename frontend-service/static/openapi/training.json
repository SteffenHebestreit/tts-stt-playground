            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/test-upload": {
      "post": {
        "summary": "Test Upload",
        "description": "Dry-run upload — returns filenames and content types without processing.",
        "operationId": "test_upload_test_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_test_upload_test_upload_post"
              }
            }
          },
