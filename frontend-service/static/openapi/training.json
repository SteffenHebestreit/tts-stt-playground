{
  "openapi": "3.1.0",
  "info": {
    "title": "Piper Voice Training Service",
    "description": "VITS neural network training pipeline for custom Piper TTS voice models",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "description": "Root endpoint — service identity.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness probe. Cheap and independent of the GPU, storage and STT.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "description": "Readiness: 200 when this service can accept a training job, 503 when its environment is broken.\n\nMirrors /health and adds what a job would need: writable data, checkpoint and\nmodel directories, and the accelerator the container was started for. A\nrunning job does not make the service \"not ready\" (that would take a busy\ntrainer out of rotation); ``accepting_jobs`` says whether the slot is free.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/deployment-targets": {
      "get": {
        "summary": "Deployment Targets",
        "description": "Return the configured deployment targets for exported model bundles.",
        "operationId": "deployment_targets_deployment_targets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/restore-backup": {
      "post": {
        "summary": "Restore Backup",
        "description": "Restore training data from a local backup directory.",
        "operationId": "restore_backup_restore_backup_post",
