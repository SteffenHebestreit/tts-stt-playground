    "/download/{job_id}": {
      "get": {
        "summary": "Download Model",
        "description": "Download the exported ONNX model for a training job.\n\nLooks up the exported file directly (job_id is path-sanitised) so models\nremain downloadable after a container restart, when completed jobs are no\nlonger present in the in-memory job registry.",
        "operationId": "download_model_download__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
