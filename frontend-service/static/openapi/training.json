    "/train": {
      "post": {
        "summary": "Train Model",
        "description": "New STT-based training endpoint that processes audio files through STT service\nfor proper segmentation before training.\n\nWorkflow:\n1. Save uploaded audio files\n2. Process through STT service for segmentation\n3. Create training segments using ffmpeg\n4. Generate training dataset\n5. Start training with optimized pipeline\n\nAnswers 409 while another job holds the training slot.",
        "operationId": "train_model_train_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_train_model_train_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/resume-training": {
      "post": {
        "summary": "Resume Training",
        "description": "Resume an interrupted training job from its latest checkpoint.\nFinds the newest checkpoint_epoch_N.pt for the job and continues from there.\n\nA job that is still running (or still stopping after a cancel) cannot be\nresumed: 409. So can a job that already completed: it is exported, not resumed.",
        "operationId": "resume_training_resume_training_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_resume_training_resume_training_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/train-from-dataset": {
      "post": {
        "summary": "Train From Dataset",
        "description": "Start training directly from an already-prepared dataset.\nRequires data/{model_name}/train.json and val.json to exist.\nSkips upload and STT — goes straight to VITS training.",
        "operationId": "train_from_dataset_train_from_dataset_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_train_from_dataset_train_from_dataset_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/retrain-from-segments": {
      "post": {
        "summary": "Retrain From Segments",
        "description": "Rebuild metadata from existing pre-segmented audio files and retrain.\n\nSkips upload and re-segmentation — uses whatever WAV files are already\nin data/{model_name}/audio/.  Runs STT on each clip to get transcriptions,\nthen calls generate_training_metadata() and train_sync().",
        "operationId": "retrain_from_segments_retrain_from_segments_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_retrain_from_segments_retrain_from_segments_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/export/{job_id}": {
      "post": {
        "summary": "Manual Export Model",
        "description": "Manually export a completed training checkpoint and deploy it to a configured target.",
        "operationId": "manual_export_model_export__job_id__post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_manual_export_model_export__job_id__post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/model/{job_id}": {
      "delete": {
        "summary": "Delete Trained Model",
        "description": "Delete a trained model and all associated files (checkpoint, export, dataset).\n\nRefused (409) while the job is running: the training thread writes into the\ndirectories this removes, and would recreate a half-deleted job.",
        "operationId": "delete_trained_model_model__job_id__delete",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
