{
  "openapi": "3.1.0",
  "info": {
    "title": "PiperTTS Service",
    "description": "Text-to-Speech using Piper with custom and default models",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "description": "Return service identity and readiness status.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Health-check endpoint used by Docker and monitoring.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "description": "Readiness: can this instance synthesise anything right now?\n\n/health only proves the process is up. This answers 503 while no voice model\nis installed (an empty bind-mounted models volume is the usual cause), the\npiper binary is missing, or the output directory is not writable, and lists\nmisconfigured defaults as warnings. Cheap: one directory stat, no model load.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/voices": {
      "get": {
        "summary": "List Voices",
        "description": "List all available voices grouped by language.",
        "operationId": "list_voices_voices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/analyze_audio": {
      "post": {
        "summary": "Analyze Audio",
        "description": "Upload an audio file and receive codec, duration, and quality metadata.",
        "operationId": "analyze_audio_analyze_audio_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_audio_analyze_audio_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tts": {
      "post": {
        "summary": "Text To Speech",
        "description": "Generate speech audio from text.\n\nSelects the best matching voice if none is specified.  Custom VITS models\nare served via ONNX Runtime; default Piper voices use the Piper CLI.",
        "operationId": "text_to_speech_tts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TTSRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/synthesize": {
      "post": {
        "summary": "Synthesize With Custom Voice",
        "description": "Synthesize speech with a named custom voice (uses ONNX Runtime).",
        "operationId": "synthesize_with_custom_voice_synthesize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoiceCloneRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/upload_model": {
      "post": {
        "summary": "Upload Custom Model",
        "description": "Upload a custom-trained ONNX model and optional JSON config.\n\nThe model is validated (loads under ONNX Runtime in a separate process, takes\nthe `text`/`text_lengths` inputs, answers a test request in time) and the\nconfig checked before anything is published. Refused: the id of a built-in\nvoice (409), more than PIPER_MAX_CUSTOM_VOICES voices (409), more than\nPIPER_MAX_CUSTOM_MB of custom models in total (413), a second upload while one\nis running (503).",
        "operationId": "upload_custom_model_upload_model_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_custom_model_upload_model_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/voice/{voice_name}": {
      "delete": {
        "summary": "Delete Custom Voice",
        "description": "Delete a custom voice and its model files.",
        "operationId": "delete_custom_voice_voice__voice_name__delete",
        "parameters": [
          {
            "name": "voice_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Voice Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get Voice Info",
        "description": "Return metadata for a single voice by name.",
        "operationId": "get_voice_info_voice__voice_name__get",
        "parameters": [
          {
            "name": "voice_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Voice Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/refresh_voices": {
      "post": {
        "summary": "Refresh Voices",
        "description": "Re-scan the default and custom model directories and update the voice registry.",
        "operationId": "refresh_voices_refresh_voices_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_analyze_audio_analyze_audio_post": {
        "properties": {
          "audio_file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Audio File"
          }
        },
        "type": "object",
        "required": [
          "audio_file"
        ],
        "title": "Body_analyze_audio_analyze_audio_post"
      },
      "Body_upload_custom_model_upload_model_post": {
        "properties": {
          "model_file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Model File"
          },
          "config_file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config File"
          },
          "voice_name": {
            "type": "string",
            "title": "Voice Name"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          }
        },
        "type": "object",
        "required": [
          "model_file",
          "voice_name"
        ],
        "title": "Body_upload_custom_model_upload_model_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TTSRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "title": "Text"
          },
          "voice": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "quality": {
            "type": "string",
            "title": "Quality",
            "default": "medium"
          },
          "gender": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gender"
          },
          "speed": {
            "type": "number",
            "maximum": 4.0,
            "exclusiveMinimum": 0.0,
            "title": "Speed",
            "default": 1.0
          },
          "output_format": {
            "type": "string",
            "title": "Output Format",
            "default": "wav"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TTSRequest",
        "description": "Request body for standard Piper text-to-speech synthesis."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VoiceCloneRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "title": "Text"
          },
          "voice_name": {
            "type": "string",
            "title": "Voice Name"
          },
          "reference_audio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Audio"
          },
          "speed": {
            "type": "number",
            "maximum": 4.0,
            "exclusiveMinimum": 0.0,
            "title": "Speed",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "text",
          "voice_name"
        ],
        "title": "VoiceCloneRequest",
        "description": "Request body for synthesis with a named custom voice."
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Published host port. Bound to 127.0.0.1 unless BACKEND_BIND_ADDR is changed; the gateway on :3000 proxies the routes the UI needs."
    }
  ]
}
