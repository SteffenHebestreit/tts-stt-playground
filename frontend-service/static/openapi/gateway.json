    "/api/providers/{provider_id}/unload": {
      "post": {
        "summary": "Provider Unload",
        "description": "Ask a provider to release its model and free the memory now.\n\nPasses the upstream status and body through verbatim rather than going via\n`_provider_json_post`, which raises on any >=400 and would flatten the\nupstream body to its `detail`. A 409 here is a normal, actionable answer —\nthe model is busy — and the caller needs the reference count that comes with\nit to know when retrying is worthwhile.",
        "operationId": "provider_unload_api_providers__provider_id__unload_post",
        "parameters": [
          {
            "name": "provider_id",
            "in": "path",
            "required": true,
