    "/api/health": {
      "get": {
        "summary": "Provider Health",
        "description": "Probe every provider's health endpoint concurrently.\n\nThe browser used to do this itself, one cross-origin request per provider,\nsequentially — so a single unreachable backend stalled the whole status row\nfor its full timeout, and every backend port had to be reachable from the\nbrowser just to render an indicator.\n\nDoing it here means the browser makes one same-origin call, the probes run in\nparallel, and the stack no longer needs its backend ports published.",
        "operationId": "provider_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
